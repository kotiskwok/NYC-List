{
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(config.js|index.html|src/(.*))", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(data|vendor|icons)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
